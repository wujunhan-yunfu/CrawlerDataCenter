# 复制为 .env 并按需修改
ENVIRONMENT=dev
DEBUG=true
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://yunfu:vG8bD5wH6yU4uU5c@yftool-db-pgvector:5432/cdc

# MongoDB(爬虫数据存储)
MONGODB_HOST=yftool-db-mongo.default
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=cdc

# Redis
REDIS_URL=redis://yftool-db-redis.default:6379/0

# 认证(JWT)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# webhook 入站校验密钥(缺省用 JWT_SECRET)
WEBHOOK_SECRET=

# 开发容器编排
ACS_IMAGE=agentcrawlerstudio:latest
K8S_NAMESPACE=cdc
DEV_CONTAINER_IDLE_TTL=1800
DEV_CONTAINER_TIMEOUT=120
WORKSPACE_CONTAINER_QUOTA=3

# 调度/心跳
HEARTBEAT_INTERVAL=30
HEARTBEAT_UNREACHABLE_MS=90000
HEARTBEAT_MONITOR_EVERY=10

# 数据入库
DATA_MAX_SINGLE_BYTES=8388608
OBJECT_STORE_IMPL=none
OBJECT_STORE_BUCKET=cdc-data

# 出站 webhook 基址(run 环境变量生成用)
RUN_WEBHOOK_BASE=http://127.0.0.1:8080/api/v1